# Скопируйте в .env (в корне репозитория) и заполните. Пустые значения = функция выключена.

# --- Основное ---
DEBUG=true                       # на сервере: false
SECRET_KEY=change-me             # на сервере: длинная случайная строка
APP_HOST=http://127.0.0.1:8000   # на сервере: https://ваш-домен
ALLOWED_HOSTS=*                  # на сервере: ваш-домен

# --- Клуб ---
CLUB_NAME=Хезеллих
CLUB_CONTACT_EMAIL=club@example.com
CLUB_MODERATOR_EMAIL=
CLUB_PAYMENTS_EMAIL=

# --- База и очередь ---
POSTGRES_DB=hezellikh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
REDIS_HOST=localhost

# --- Оплата: ЮKassa (для начала — ключи тестового магазина) ---
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=

# --- Почта (коды входа, письма об оплате) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Загрузка картинок ---
# По умолчанию файлы сохраняются на этом же сервере в папку media/
MEDIA_UPLOAD_URL=/upload/

# --- Telegram (бот и каналы клуба) ---
TELEGRAM_TOKEN=
TELEGRAM_BOT_URL=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CLUB_CHANNEL_URL=
TELEGRAM_CLUB_CHANNEL_ID=
TELEGRAM_CLUB_CHAT_ID=
TELEGRAM_ONLINE_CHANNEL_URL=
TELEGRAM_ONLINE_CHANNEL_ID=
TELEGRAM_VIBES_CHAT_ID=
TELEGRAM_PARLIAMENT_CHAT_ID=
TELEGRAM_EVENTS_CHAT_ID=

# --- Карта участников (Mapbox, публичный токен) ---
MAPBOX_TOKEN=
MAPBOX_STYLE=

# --- Необязательное ---
SENTRY_DSN=
OPENAI_API_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
WEBHOOK_SECRETS=
